# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=listalicious

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_DEV_SECRET
# Access token lifetime in minutes (recommend 15–60 in prod)
ACCESS_TOKEN_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "prod" to enable strict startup validation
ENV=dev
# Your frontend URL — used in email links and CORS
APP_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS (REQUIRED in prod)
ALLOWED_ORIGINS=http://localhost:3000

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# REQUIRED in production
SENDGRID_API_KEY=
# Must be a verified sender or domain in your SendGrid account
EMAIL_FROM=no-reply@example.com
